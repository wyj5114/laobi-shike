# =============================================================================
# 老哔拾课 · 本地运行配置（backend/.env.example）
# start_local.bat 首次运行会自动复制成 backend/.env
# 改完需要重启后端才生效。
# =============================================================================

ENV=production

# 目录
STATIC=/static
OUT_DIR=./static/screenshots
NOTE_OUTPUT_DIR=note_results
IMAGE_BASE_URL=/static/screenshots
DATA_DIR=data

# 后端监听（前端 Vite 代理默认指向 8484，改这里要同步改 frontend/vite.config.ts）
BACKEND_PORT=8484
BACKEND_HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1
SCREENSHOT_BASE_URL=http://127.0.0.1:8484/static/screenshots

# 仓库自带 Windows 版 ffmpeg；路径相对于 backend/ 目录
FFMPEG_BIN_PATH=../tools/ffmpeg/bin

# 转写器：fast-whisper / bcut / kuaishou / groq / mlx-whisper(仅 Mac)
# 首次使用建议先下 tiny（~75MB），确认流程跑通再换 base/small
TRANSCRIBER_TYPE=fast-whisper
WHISPER_MODEL_SIZE=base

# 下载性能
YDL_CONCURRENT_FRAGMENTS=4
YDL_HTTP_CHUNK_SIZE=10485760
VIDEO_MAX_HEIGHT=720

# B 站登录态（可选）。没有 Cookie 时也能下 480P/720P，但 1080P 高码率、
# 部分 AI 字幕拿不到。手动 Cookie 优先，其次读浏览器：
# BILIBILI_COOKIES_FROM_BROWSER=edge

# Whisper 模型下载源（国内镜像；下载失败可改成 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com
